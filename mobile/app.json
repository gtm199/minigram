{
  "expo": {
    "name": "MiniGram",
    "slug": "minigram",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "minigram",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.minigram.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MiniGram needs access to your photos so you can share posts and set a profile picture."
        }
      ],
      "expo-status-bar",
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07c214e0-fec3-49ea-bcbd-deb68dda59c2"
      }
    },
    "owner": "gtm199",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/07c214e0-fec3-49ea-bcbd-deb68dda59c2"
    }
  }
}
