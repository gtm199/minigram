# Environment variables for deploying the backend on Kuberns.
# Kuberns has no repo config file (no equivalent of render.yaml); set these in the
# dashboard's Environment section, or copy this file to kuberns.env, fill it in, and upload it.
# kuberns.env is git-ignored: never commit real values.
#
# Service setup in the dashboard: point it at the backend/ folder (it uses backend/Dockerfile).

# ---- Required ----
DJANGO_SETTINGS_MODULE=config.settings.production

# Two DIFFERENT long random strings. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
JWT_SIGNING_KEY=change-me-too

# Postgres connection URL (from the Kuberns database or an external provider).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Hosts / CORS ----
# *.kuberns.cloud is already allowed in config/settings/production.py.
# Add custom domains here (comma-separated), e.g. api.example.com
ALLOWED_HOSTS=
# Matching https:// origins for any custom domains above, e.g. https://api.example.com
CSRF_TRUSTED_ORIGINS=
# Browser frontends that call the API, e.g. https://app.example.com (not needed for the native mobile app)
CORS_ALLOWED_ORIGINS=

# Set to False only if the site gets stuck in a redirect loop (proxy not sending X-Forwarded-Proto).
SECURE_SSL_REDIRECT=True

# ---- Media storage (recommended) ----
# Container disks are wiped on redeploy, so use Cloudinary for uploaded images/videos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Upload limits (optional) ----
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=25

# ---- Server (optional) ----
# The container listens on $PORT (defaults to 10000). Set it if Kuberns expects another port.
# PORT=8000
# Gunicorn worker count.
# WEB_CONCURRENCY=2

# ---- First admin user, created on boot if it doesn't exist (optional) ----
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me
